# ========================================================
# Telegram Bot Configuration
# ========================================================
# รับ Token ได้จาก @BotFather บน Telegram (พิมพ์ /newbot)
TELEGRAM_BOT_TOKEN=

# รูปแบบการทำงานของบอท: "polling" (แนะนำ รันบนเครื่องได้ทันทีไม่ต้องง้อ ngrok) หรือ "webhook"
TELEGRAM_MODE=polling

# (เฉพาะกรณีใช้ webhook) URL ของเซิร์ฟเวอร์ เช่น https://your-domain.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# (ทางเลือก) กำหนด Chat ID เริ่มต้นให้รับแจ้งเตือนทันที
DEFAULT_TELEGRAM_CHAT_ID=

# ========================================================
# Database Configuration
# ========================================================
# ค่าเริ่มต้นใช้ SQLite ในตัวเครื่อง (jobs.db) หรือระบุ PostgreSQL เช่น บน Railway
DATABASE_URL=sqlite:///jobs.db

# ========================================================
# Scraper & Worker Settings
# ========================================================
POLL_INTERVAL_SECONDS=30
FASTWORK_ENABLED=true
FACEBOOK_ENABLED=true

# Prompt เริ่มต้นของระบบสำหรับผู้ติดตามที่ไม่ได้ระบุเงื่อนไขเอง
DEFAULT_PROMPT=งานเขียนโปรแกรม ซอฟต์แวร์ ทำเว็บ แอปพลิเคชัน และ AI

# Facebook Groups ที่ต้องการติดตาม (คั่นด้วยเครื่องหมายจุลภาค)
FB_GROUP_IDS=thaiprogrammer,webdeveloperthailand,reactthailand,flutterthailand,pythonthailand,datasciencethailand,wordpressdeveloperthai,itjobthailand,frontenddeveloperthailand,nodethailand,vuejsthailand,golangthailand,programmersfreelance,androiddevthailand,iosdevthailand

# จำลองข้อมูล Facebook อัตโนมัติหากไม่มี Cookie Facebook บัญชีจริง (ตั้งเป็น false เพื่อปิดตัวทดสอบ)
FB_DEMO_FALLBACK=false

# Web Server Port
PORT=5000
